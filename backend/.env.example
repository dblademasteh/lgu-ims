# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://lguims:lguims@localhost:5433/lgu_ims?schema=public"

# Auth
JWT_SECRET="change-this-in-production-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=10

# CORS (comma-separated origins; * for any)
CORS_ORIGINS="http://localhost:5173"

# Optional email alerts via Nodemailer
# Leave SMTP_* unset to disable email alerts
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="LGU IMS <no-reply@lgu.local>"
EMAIL_NOTIFY_ENABLED=false