generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  WAREHOUSE_STAFF
  PROPERTY_CUSTODIAN
  AUDITOR
  DEPARTMENT_HEAD
}

enum RisStatus {
  PENDING
  APPROVED
  CERTIFIED
  PARTIALLY_ISSUED
  ISSUED
  REJECTED
  CANCELLED
}

enum LedgerReferenceType {
  OPENING_BALANCE
  RECEIPT
  ISSUANCE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  RETURN
}

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  code      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Department {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  code      String    @unique
  headName  String?
  parentId  String?   @db.Uuid
  parent    Department? @relation("DeptHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DeptHierarchy")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users     User[]
  ris       Ris[]
  purchaseOrders PurchaseOrder[]
  budgets   Budget[]
  physicalCounts PhysicalCount[]
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items Item[]
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String      @default("default") @db.Text
  username     String
  email        String
  password     String
  fullName     String
  role         Role        @default(WAREHOUSE_STAFF)
  isActive     Boolean  @default(true)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret   String?
  passwordChangedAt DateTime?
  lastLoginAt  DateTime?
  failedLoginAttempts Int @default(0)
  lockedUntil  DateTime?
  externalId   String? // future SSO / HRIS integration
  departmentId String?  @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  requestedRis  Ris[]       @relation("RisRequestor")
  approvedRis   Ris[]       @relation("RisApprover")
  certifiedRis  Ris[]       @relation("RisCertifier")
  issuedRis     Ris[]       @relation("RisIssuer")
  ledgerEntries LedgerEntry[]
  notifications Notification[]
  auditLogs     AuditLog[]
  receivings    Receiving[]
  apiKeys       ApiKey[]
  purchaseOrders PurchaseOrder[]
  refreshTokens RefreshToken[]
  previousPasswords PreviousPassword[]
  physicalCounts PhysicalCount[]
  notificationPreferences NotificationPreference[]

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@index([tenantId])
}

model Item {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @default("default") @db.Text
  sku              String
  stockNumber      String?
  fundCluster      String?
  name             String
  description      String?
  category         Category @relation(fields: [categoryId], references: [id])
  categoryId       String   @db.Uuid
  unit             String
  reorderThreshold Float    @default(0)
  maxStock        Float    @default(0)
  currentStock     Float    @default(0)
  unitCost         Float    @default(0)
  imageUrl         String?
  isActive         Boolean  @default(true)
  isAccountable    Boolean  @default(false)
  condition        String? @default("SERVICEABLE")
  expiryDate       DateTime?
  warrantyExpiry   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ledgerEntries LedgerEntry[]
  risItems      RisItem[]
  notifications Notification[]
  receivingItems ReceivingItem[]
  purchaseOrderItems PurchaseOrderItem[]
  physicalCountItems PhysicalCountItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model LedgerEntry {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @default("default") @db.Text
  item           Item                 @relation(fields: [itemId], references: [id])
  itemId         String               @db.Uuid
  referenceType  LedgerReferenceType
  referenceId    String?
  date           DateTime             @default(now())
  inflow         Float                @default(0)
  outflow        Float                @default(0)
  runningBalance Float                @default(0)
  remarks        String?
  createdBy      User?                @relation(fields: [createdById], references: [id])
  createdById    String?              @db.Uuid
  createdAt      DateTime             @default(now())

  @@index([itemId, date])
  @@index([referenceType])
  @@index([tenantId])
}

model Ris {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @default("default") @db.Text
  risNumber     String
  department    Department @relation(fields: [departmentId], references: [id])
  departmentId  String    @db.Uuid
  purpose       String
  requestedBy   User      @relation("RisRequestor", fields: [requestedById], references: [id])
  requestedById String    @db.Uuid
  status        RisStatus @default(PENDING)
  approvedBy    User?     @relation("RisApprover", fields: [approvedById], references: [id])
  approvedById  String?   @db.Uuid
  approvedAt    DateTime?
  certifiedBy   User?     @relation("RisCertifier", fields: [certifiedById], references: [id])
  certifiedById String?   @db.Uuid
  certifiedAt   DateTime?
  issuedBy      User?     @relation("RisIssuer", fields: [issuedById], references: [id])
  issuedById    String?   @db.Uuid
  issuedAt      DateTime?
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items         RisItem[]

  @@unique([tenantId, risNumber])
  @@index([tenantId])
}

model RisItem {
  id                String @id @default(uuid()) @db.Uuid
  tenantId          String @default("default") @db.Text
  ris               Ris    @relation(fields: [risId], references: [id], onDelete: Cascade)
  risId             String @db.Uuid
  item              Item   @relation(fields: [itemId], references: [id])
  itemId            String @db.Uuid
  quantityRequested Float
  quantityApproved  Float  @default(0)
  quantityIssued    Float  @default(0)
  unitCost          Float  @default(0)

  @@index([risId])
  @@index([itemId])
  @@index([tenantId])
}

model EmailJob {
  id        String   @id @default(uuid()) @db.Uuid
  to        String
  subject   String
  text      String?
  html      String?
  status    EmailJobStatus @default(PENDING)
  attempts  Int @default(0)
  maxAttempts Int @default(5)
  error     String?
  scheduledAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
}

enum EmailJobStatus {
  PENDING
  SENT
  FAILED
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @default("default") @db.Text
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?   @db.Uuid
  type      String
  title     String
  message   String
  isRead    Boolean   @default(false)
  item      Item?     @relation(fields: [itemId], references: [id])
  itemId    String?   @db.Uuid
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([tenantId])
}

model NotificationPreference {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @default("default") @db.Text
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  type      String
  email     Boolean  @default(true)
  inApp     Boolean  @default(true)

  @@unique([userId, type])
  @@index([tenantId])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @default("default") @db.Text
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?  @db.Uuid
  action       String
  entityType   String
  entityId     String?
  before       Json?
  after        Json?
  ip           String?
  createdAt    DateTime @default(now())
  chainHash    String   @default("")
  previousHash String   @default("")

  @@index([entityType, entityId])
  @@index([action])
  @@index([tenantId])
}

model ApiKey {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @default("default") @db.Text
  name        String
  keyPrefix   String
  keyHash     String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String   @db.Uuid

  @@index([keyPrefix])
  @@index([tenantId])
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @default("default") @db.Text
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receivings Receiving[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Receiving {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @default("default") @db.Text
  receivingNo  String
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  supplierId   String   @db.Uuid
  receiptDate  DateTime @default(now())
  poNumber     String?
  drNumber     String?
  remarks      String?
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdById  String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId String?   @db.Uuid

  items ReceivingItem[]

  @@unique([tenantId, receivingNo])
  @@index([tenantId])
  @@index([supplierId])
}

model ReceivingItem {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @default("default") @db.Text
  receiving    Receiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  receivingId  String    @db.Uuid
  item         Item      @relation(fields: [itemId], references: [id])
  itemId       String    @db.Uuid
  quantity     Float
  unitCost     Float     @default(0)
  remarks      String?

  @@index([receivingId])
  @@index([itemId])
  @@index([tenantId])
}

model PurchaseOrder {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @default("default") @db.Text
  poNumber      String
  departmentId  String   @db.Uuid
  department    Department @relation(fields: [departmentId], references: [id])
  supplierId    String   @db.Uuid
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  date          DateTime @default(now())
  status        String @default("PENDING")
  totalAmount   Float @default(0)
  remarks       String?
  createdBy     User @relation(fields: [createdById], references: [id])
  createdById   String @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         PurchaseOrderItem[]
  receivings    Receiving[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([departmentId])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @default("default") @db.Text
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String   @db.Uuid
  itemId          String   @db.Uuid
  item            Item @relation(fields: [itemId], references: [id])
  quantity        Float
  unitCost        Float @default(0)
  receivedQuantity Float @default(0)

  @@index([purchaseOrderId])
  @@index([itemId])
  @@index([tenantId])
}

model PreviousPassword {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @default("default") @db.Text
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
}

model RefreshToken {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @default("default") @db.Text
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?
  replacedById String?  @db.Uuid
  replacedBy   RefreshToken? @relation("replacedTokens", fields: [replacedById], references: [id])
  replacedTokens RefreshToken[] @relation("replacedTokens")

  @@index([userId])
  @@index([token])
  @@index([tenantId])
}

model Budget {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @default("default") @db.Text
  departmentId String    @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])
  amount       Float
  spent        Float     @default(0)
  year         Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([departmentId, year])
  @@index([tenantId])
}

model PhysicalCount {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @default("default") @db.Text
  departmentId String   @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id])
  countDate    DateTime @default(now())
  status       String   @default("DRAFT")
  remarks      String?
  createdBy    User      @relation(fields: [createdById], references: [id])
  createdById  String   @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items        PhysicalCountItem[]

  @@index([departmentId])
  @@index([countDate])
  @@index([tenantId])
}

model PhysicalCountItem {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @default("default") @db.Text
  physicalCount  PhysicalCount @relation(fields: [physicalCountId], references: [id], onDelete: Cascade)
  physicalCountId String   @db.Uuid
  itemId         String   @db.Uuid
  item           Item      @relation(fields: [itemId], references: [id])
  systemQuantity Float
  countedQuantity Float
  variance       Float
  remarks        String?

  @@index([physicalCountId])
  @@index([itemId])
  @@index([tenantId])
}


